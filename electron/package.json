{
  "name": "pumail",
  "version": "1.1.5",
  "private": true,
  "description": "PuMail desktop shell",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis",
    "pack:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pumail.desktop",
    "productName": "PuMail",
    "directories": {
      "output": "../PuMail-build"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../dist/PuMail",
        "to": "pumail-server",
        "filter": [
          "**/*",
          "!**/*.db",
          "!**/*.db-wal",
          "!**/*.db-shm",
          "!**/*.secret",
          "!**/*.vault",
          "!**/imap-debug.log"
        ]
      },
      {
        "from": "../packaging/generated/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../packaging/assets/cat.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "icon": "../packaging/assets/cat.ico",
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "PuMail",
      "artifactName": "PuMail-Setup.exe",
      "include": "../packaging/installer.nsh",
      "installerIcon": "../packaging/assets/cat.ico",
      "uninstallerIcon": "../packaging/assets/cat.ico",
      "installerSidebar": "../packaging/generated/sidebar.bmp",
      "uninstallerSidebar": "../packaging/generated/sidebar.bmp",
      "installerHeader": "../packaging/generated/header.bmp"
    }
  },
  "allowScripts": {}
}
